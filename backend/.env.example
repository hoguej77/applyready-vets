# Never put this file or a real key in the iOS app.
# auto prefers Apple on-device AI on an eligible macOS 27 Mac, then OpenAI, then safe deterministic rules.
HOGUE_AI_PROVIDER=auto
OPENAI_API_KEY=
HOGUE_OPENAI_MODEL=gpt-5.6-sol
HOGUE_OPENAI_TIMEOUT_SECONDS=30
HOGUE_OPENAI_MAX_RETRIES=2
HOGUE_OPENAI_MAX_OUTPUT_TOKENS=4000
HOGUE_APPLE_FM_TIMEOUT_SECONDS=90
HOGUE_APPLE_FM_MAX_PROMPT_CHARS=12000

# Optional shared development token. Production should use real user authentication.
HOGUE_API_TOKEN=

HOGUE_MAX_UPLOAD_BYTES=10485760
HOGUE_MAX_TEXT_CHARS=200000
HOGUE_ENVIRONMENT=development
